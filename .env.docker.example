# Plantilla para `docker compose`. Cópiala a `.env.docker` (NO se versiona) y sustituye los marcadores:
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --build
# Genera cada secreto con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- Base de datos (solo accesible desde la red interna de Docker) ---
MYSQL_ROOT_PASSWORD=CAMBIAR_POR_UN_VALOR_ALEATORIO
MYSQL_PASSWORD=CAMBIAR_POR_UN_VALOR_ALEATORIO
# MYSQL_DATABASE=a_link
# MYSQL_USER=alink

# --- Aplicación ---
# Origen público EXACTO con el que se abrirá la aplicación (en producción, siempre https).
PUBLIC_ORIGIN=https://localhost:8443
# Puerto publicado por Nginx (el único del stack).
# HTTPS_PORT=8443
# Mínimo 32 caracteres aleatorios.
SESSION_SECRET=CAMBIAR_POR_UN_VALOR_ALEATORIO_LARGO
# Con false se cierra el alta de cuentas (el seed de demostración sigue funcionando).
# REGISTRATION_ENABLED=true

# --- Licencia de ZoomCharts (se inyecta al arrancar el contenedor web, nunca se compila en el bundle) ---
# Sin ella el lienzo no se dibuja; el editor sigue funcionando desde los paneles. Se admiten caracteres ASCII imprimibles
# salvo comillas dobles y barra invertida.
ZOOMCHARTS_LICENSE=
ZOOMCHARTS_LICENSE_KEY=

# --- Datos de demostración (solo para `docker compose --profile seed run --rm seed`) ---
# DEMO_USER_EMAIL=demo@example.test
# Mínimo 12 caracteres y sin la parte local del correo. Solo se necesita al ejecutar el seed.
# DEMO_USER_PASSWORD=CAMBIAR_POR_UNA_FRASE_LARGA

# --- Almacenamiento de exportaciones: volumen local por defecto; para S3/MinIO ---
# STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
