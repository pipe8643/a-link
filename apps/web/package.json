{
  "name": "@a-link/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:firefox": "playwright test --project=firefox",
    "e2e:webkit": "playwright test --project=webkit --workers=1",
    "e2e:cross": "npm run e2e:firefox && npm run e2e:webkit",
    "e2e:stack": "playwright test -c playwright.stack.config.ts"
  },
  "dependencies": {
    "@a-link/shared": "0.1.0",
    "@dvsl/zoomcharts": "1.21.21",
    "@hookform/resolvers": "5.9.2",
    "@mediapipe/tasks-vision": "1.1.1",
    "@tanstack/react-query": "5.105.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jszip": "3.10.2",
    "lucide-react": "1.59.0",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-router": "7.18.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.4"
  }
}
