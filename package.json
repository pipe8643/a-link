{
  "name": "a-link",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de análisis de relaciones y grafos (ZoomCharts Net Chart)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @a-link/shared && npm run build -w @a-link/api && npm run build -w @a-link/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:web": "npm run test -w @a-link/web",
    "test:e2e": "npm run e2e -w @a-link/web",
    "test:scripts": "vitest run scripts",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "scan:secrets:images": "node scripts/secret-scan.mjs --images",
    "scan:unsafe": "node scripts/scan-unsafe.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "overrides": {
    "image-size": "2.0.4",
    "multer": "2.5.0",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
