# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
# Todos los valores de abajo son marcadores, no credenciales reales.

NODE_ENV=development

# --- API ---
API_PORT=3000
# Orígenes permitidos por CORS y verificación CSRF (separados por comas, sin comodines)
APP_ORIGINS=http://localhost:5173

# --- Frontend (solo desarrollo; opcionales) ---
# El servidor de Vite escucha en 127.0.0.1:WEB_PORT y reenvía /api al backend (WEB_API_TARGET).
# Por defecto: puerto 5173 y http://127.0.0.1:API_PORT. Los E2E de Playwright usan puertos propios.
# WEB_PORT=5173
# WEB_API_TARGET=http://127.0.0.1:3000
# Interfaz de escucha. En local se queda en loopback; en contenedor se usa 0.0.0.0 detrás de Nginx.
API_HOST=127.0.0.1
# Saltos de proxy de confianza (0 = sin proxy). Con Nginx delante: 1. Necesario para que el límite
# de intentos y los registros vean la IP real del cliente y no la del proxy.
TRUST_PROXY_HOPS=0
# Registro abierto de usuarios (pon false para instalaciones privadas)
REGISTRATION_ENABLED=true

# --- Base de datos (MySQL >= 8.0.16; probado con 8.4) ---
# Crea las bases y el usuario con apps/api/prisma/setup-mysql.sql
# Si la contraseña tiene caracteres especiales, codifícalos (@ -> %40, ! -> %21, / -> %2F).
# Host remoto: añade ?ssl=true (en localhost no hace falta).
DATABASE_URL=mysql://alink:CONTRASENA@localhost:3306/a_link
# Base de datos distinta y DESECHABLE para pruebas de integración (se VACÍAN sus tablas en cada ejecución)
TEST_DATABASE_URL=mysql://alink:CONTRASENA@localhost:3306/a_link_test

# --- Sesiones y seguridad ---
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CAMBIAR_POR_UN_VALOR_ALEATORIO_LARGO
SESSION_COOKIE_NAME=alink_sid
SESSION_TTL_HOURS=12
SESSION_ABSOLUTE_TTL_DAYS=14
PASSWORD_RESET_TTL_MINUTES=30

# Argon2id (valores mínimos recomendados por OWASP; súbelos si el servidor lo permite)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Límites anti-abuso. El limitador de intentos de login es EN MEMORIA: válido para UNA instancia de API.
RATE_LIMIT_PER_MINUTE=120          # general, por IP
AUTH_RATE_LIMIT_PER_MINUTE=10      # login/registro/recuperación, por IP
LOGIN_MAX_ATTEMPTS_PER_IP_EMAIL=5  # fallos en 15 min por IP + correo
LOGIN_MAX_ATTEMPTS_PER_EMAIL=30    # fallos en 1 h por correo (todas las IP)

# Correo (recuperación de contraseña). 'file' escribe el enlace en MAIL_DIR: SOLO desarrollo.
# En producción el valor por defecto es 'disabled' hasta que exista el adaptador SMTP.
# MAIL_DRIVER=file
MAIL_DIR=./storage/dev-mail

# --- Almacenamiento privado de exportaciones ---
STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_DIR=./storage     # fuera de cualquier ruta servida estáticamente
S3_ENDPOINT=                    # p. ej. http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Límites ---
MAX_NODES_PER_GRAPH=5000
MAX_EDGES_PER_GRAPH=20000
MAX_EXPORT_FILE_MB=50
# Espacio total de exportaciones guardadas por usuario (además del máximo de 500 archivos).
EXPORT_QUOTA_MB_PER_USER=512
MAX_REQUEST_BODY_MB=2
# Tamaño máximo del guardado del contenido de un grafo (PUT /graphs/:id/content).
MAX_GRAPH_CONTENT_MB=16

# --- Frontend (se inyecta en tiempo de ejecución mediante /config.js, no se compila) ---
# Licencia de ZoomCharts: se obtiene en https://js.zoomcharts.com/pricing (prueba de 30 días).
# Sin ella el lienzo NO se dibuja (el editor sigue funcionando desde los paneles y avisa del error).
# En desarrollo (`vite`/`vite preview`) se sirve en /config.js leyendo este fichero; el build emite un
# config.js VACÍO y en producción lo genera el contenedor web al arrancar desde variables de entorno (ver .env.docker.example).
# Tras cambiar estos valores, reinicia Vite.
ZOOMCHARTS_LICENSE=
ZOOMCHARTS_LICENSE_KEY=

# --- Docker ---
# Este fichero es para desarrollo local. Para docker compose usa .env.docker (plantilla: .env.docker.example, ver docs/10-despliegue.md).
